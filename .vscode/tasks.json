{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-I/usr/include/opencv4",
                "-I${workspaceFolder}/include",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "C/C++: 编译 lightbar_detection（全部源文件）",
            "command": "g++ -std=c++17 -g -fdiagnostics-color=always src/main.cpp src/lightbar.cpp src/armor.cpp src/visualize.cpp -o build/lightbar_detection -Iinclude $(pkg-config --cflags --libs opencv4)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "拆分多文件后需一起编译（等价于 CMake 目标 lightbar_detection）。"
        }
    ],
    "version": "2.0.0"
}